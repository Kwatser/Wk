# PostgreSQL connection string. Locally and on Vercel this should point at your
# hosted database (e.g. a free Neon project: https://neon.tech).
#
# Use the POOLED connection string for the app at runtime. If `prisma db push`
# complains, use the DIRECT (unpooled) string for that one command.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
